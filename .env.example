# URL pública del sitio (para SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.seisac.cl

# WhatsApp: formato internacional sin "+" ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER=56962262519

# Resend (https://resend.com) — envío del formulario de contacto
RESEND_API_KEY=
# Casilla de la empresa que recibe los formularios
CONTACT_TO_EMAIL=contacto@seisac.cl
# Remitente verificado en Resend (mientras no verifiques dominio usa onboarding@resend.dev)
CONTACT_FROM_EMAIL="SEISAC Web <onboarding@resend.dev>"

# WhatsApp Business Cloud API (Meta) — OPCIONAL, desactivado por defecto
WHATSAPP_NOTIFY_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número que recibe la notificación (formato 569XXXXXXXX). Por defecto usa NEXT_PUBLIC_WHATSAPP_NUMBER
WHATSAPP_NOTIFY_TO=
